{
    "name": "indianopinion/comments-through-cache",
    "description": "WordPress must-use plugin: a held comment stays visible to the reader who wrote it behind a page cache, and an approved comment purges exactly the article's URLs.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "keywords": ["wordpress", "comments", "moderation", "cache", "purge", "nginx", "varnish", "cloudflare"],
    "homepage": "https://github.com/IndianOpinion/comments-through-cache",
    "support": {
        "issues": "https://github.com/IndianOpinion/comments-through-cache/issues",
        "email": "hello@indianopinion.org"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.9",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\CommentsThroughCache\\": "src/"
        },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\CommentsThroughCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
