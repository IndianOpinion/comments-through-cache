parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - comments-through-cache.php
        - uninstall.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
